{
  "name": "devready-web-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DevReady Web Studio — Free full-screen Figma Dev Mode alternative on the web with hover-to-measure redlines, 12-target codegen, tokens, assets, A11y, and zero-cost E2E encrypted Figma transfer.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.6"
  }
}
